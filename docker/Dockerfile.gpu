# NVIDIA CUDA image (needs the NVIDIA Container Toolkit on the host). Build from the repository root:
#   docker build -f docker/Dockerfile.gpu -t voxora-ai-engine:gpu .
# NOTE: base-image tags / wheel indexes change over time; this file was not built in the authoring sandbox.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ARG INSTALL_AI=true
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VOXORA_DATA_DIR=/data \
    VOXORA_DEVICE=cuda \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends software-properties-common ca-certificates \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y --no-install-recommends python3.11 python3.11-venv python3.11-dev build-essential ffmpeg libsndfile1 \
 && rm -rf /var/lib/apt/lists/* \
 && python3.11 -m venv /opt/venv

WORKDIR /srv/voxora
COPY requirements.txt requirements-ai.txt ./
RUN pip install -r requirements.txt
RUN if [ "$INSTALL_AI" = "true" ]; then \
      pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu124 \
      && pip install -r requirements-ai.txt ; \
    fi

COPY . .
RUN useradd --create-home --uid 10001 voxora && mkdir -p /data && chown -R voxora:voxora /data /srv/voxora
USER voxora
VOLUME ["/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD ["python", "scripts/healthcheck.py"]
ENTRYPOINT ["docker/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
