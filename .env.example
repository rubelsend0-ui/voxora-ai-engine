# Copy to .env and edit. Every variable is prefixed with VOXORA_.
# NEVER commit your real .env.

VOXORA_ENVIRONMENT=development            # development | test | production
# Required in production: random string, >= 32 chars.  python -c "import secrets;print(secrets.token_urlsafe(48))"
VOXORA_API_KEY_PEPPER=change-me-in-production

# --- storage / database ---
VOXORA_DATA_DIR=./data                    # holds storage/, models/ and tmp/
# VOXORA_MODELS_DIR=./data/models         # keep model weights on a separate disk if you like
VOXORA_DATABASE_URL=sqlite:///./data/voxora.db
# VOXORA_DATABASE_URL=postgresql+psycopg://voxora:password@localhost:5432/voxora
VOXORA_AUTO_CREATE_TABLES=true            # SQLite dev convenience. With PostgreSQL: false + `alembic upgrade head`

# --- jobs ---
VOXORA_JOB_BACKEND=local                  # local (thread pool) | celery (needs Redis) | inline (tests only)
VOXORA_LOCAL_WORKERS=1                    # keep 1 on a single GPU
# VOXORA_REDIS_URL=redis://localhost:6379/0

# --- security ---
VOXORA_CORS_ORIGINS=                      # comma separated; empty = disabled (native mobile apps do not need CORS)
VOXORA_MAX_UPLOAD_MB=500
VOXORA_RATE_LIMIT_PER_MINUTE=120
VOXORA_RATE_LIMIT_HEAVY_PER_MINUTE=12
VOXORA_DOCS_ENABLED=true

# --- AI ---
VOXORA_DEVICE=auto                        # auto | cpu | cuda
VOXORA_WHISPER_MODEL_SIZE=small           # tiny | base | small | medium | large-v3 | large-v3-turbo
VOXORA_DUBBING_MAX_SPEEDUP=1.4
